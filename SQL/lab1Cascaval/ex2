Часть 2. Модификация (ALTER), Индексы, DML
1. Работа с ALTER TABLE:

-- Добавление колонки
ALTER TABLE students ADD COLUMN middle_name VARCHAR(50);

-- Удаление колонки
ALTER TABLE teachers DROP COLUMN phone;

-- Изменение названия колонки (в MySQL: CHANGE/RENAME COLUMN)
ALTER TABLE classrooms RENAME COLUMN capacity TO max_seats;

-- Изменение типа данных
ALTER TABLE students ALTER COLUMN middle_name TYPE VARCHAR(100);

-- Добавление ограничения (CHECK)
ALTER TABLE students ADD CONSTRAINT chk_birth_date CHECK (birth_date >= '2000-01-01');

-- Создание индекса для ускорения поиска по фамилии
CREATE INDEX idx_students_last_name ON students(last_name);


