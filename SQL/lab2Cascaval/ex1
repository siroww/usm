-- 1. Строковые функции (UPPER, CONCAT, SUBSTRING) + WHERE + ORDER BY + Alias
SELECT 
    UPPER(last_name) AS upper_last_name, 
    CONCAT(first_name, ' ', last_name) AS full_name,
    SUBSTRING(email, 1, 3) AS email_prefix
FROM teachers
WHERE teacher_id > 1
ORDER BY last_name ASC;

-- 2. Функции дат (CURRENT_DATE, EXTRACT) + Арифметика (возраст учеников) + WHERE
SELECT 
    first_name, 
    last_name, 
    birth_date,
    EXTRACT(YEAR FROM AGE(CURRENT_DATE, birth_date)) AS age_years,
    EXTRACT(YEAR FROM birth_date) + 18 AS adult_year -- Арифметика с датой
FROM students
WHERE birth_date >= '2008-01-01'
ORDER BY birth_date DESC;

-- 3. Арифметика (умножение вместимости кабинета на коэффициент) + Alias + WHERE
SELECT 
    room_number,
    max_seats,
    max_seats * 2 AS double_capacity_estimation
FROM classrooms
WHERE max_seats >= 25
ORDER BY max_seats DESC;

-- 4. Работа с датами (форматирование/сравнение) + WHERE + Alias
SELECT 
    student_id, 
    grade, 
    grade_date,
    grade_date + INTERVAL '7 days' as retake_deadline -- Арифметика с датами (PostgreSQL)
FROM grades
WHERE grade_date >= '2026-09-01'
ORDER BY grade_date;

-- 5. Строковые функции (LOWER, LENGTH) + WHERE + Alias
SELECT 
    subject_name,
    LOWER(subject_name) AS lower_subject,
    LENGTH(subject_name) AS name_length
FROM subjects
WHERE LENGTH(subject_name) > 6;

-- АГРЕГАТНЫЕ ФУНКЦИИ (COUNT, SUM, AVG, MIN, MAX) с GROUP BY и HAVING

-- 6. COUNT: Количество учеников в каждом классе
SELECT 
    class_id,
    COUNT(student_id) AS total_students
FROM students
GROUP BY class_id
HAVING COUNT(student_id) >= 1;

-- 7. AVG: Средняя оценка по каждому предмету
SELECT 
    subject_id,
    ROUND(AVG(grade), 2) AS average_grade
FROM grades
GROUP BY subject_id
HAVING AVG(grade) >= 8;

-- 8. MAX: Максимальная оценка ученика
SELECT 
    student_id,
    MAX(grade) AS max_grade
FROM grades
GROUP BY student_id
HAVING MAX(grade) >= 9;

-- 9. MIN: Минимальная оценка по предметам
SELECT 
    subject_id,
    MIN(grade) AS min_grade
FROM grades
GROUP BY subject_id
HAVING MIN(grade) <= 8;

-- 10. SUM: Общая сумма «баллов/оценок» по предметам (для примера использования SUM)
SELECT 
    subject_id,
    SUM(grade) AS sum_grades
FROM grades
GROUP BY subject_id
HAVING SUM(grade) > 5;